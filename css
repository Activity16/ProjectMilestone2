<!DOCTYPE html>
</html>

    <head>
      /* ==========================================================================
   1. STYLING (Google Fonts, Custom Variables, & Reset)
   ========================================================================== */

/* Google Font Pairing: Inter (Headings) + Roboto (Body) */
@import url('https://googleapis.com');

:root {
    /* Color Palette */
    --primary-color: #2563eb;    /* Deep Royal Blue */
    --secondary-color: #0f172a;  /* Slate Dark */
    --accent-color: #f59e0b;     /* Warm Amber */
    --bg-light: #f8fafc;         /* Soft Light Gray */
    --bg-white: #ffffff;         /* Pure White */
    --text-main: #334155;        /* Readable Charcoal */
    --text-muted: #64748b;       /* Muted Gray */

    /* Spacing System (Multiples of 8px) */
    --space-xs: 8px;
    --space-sm: 16px;
    --space-md: 24px;
    --space-lg: 32px;
    --space-xl: 64px;
}

/* Global Reset & Base Styling */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Roboto', sans-serif;
    background-color: var(--bg-light);
    color: var(--text-main);
    line-height: 1.6;
}

/* Type Selectors */
h1, h2, h3 {
    font-family: 'Inter', sans-serif;
    color: var(--secondary-color);
    margin-bottom: var(--space-sm);
}

a {
    color: var(--primary-color);
    text-decoration: none;
    transition: color 0.3s ease;
}

a:hover {
    color: var(--accent-color);
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

/* ==========================================================================
   2. LAYOUT (Structure, Global Components, & ID Selectors)
   ========================================================================== */

/* ID Selector - Unique Page Layout Component */
#main-header {
    background-color: var(--secondary-color);
    color: var(--bg-white);
    padding: var(--space-sm) var(--space-md);
    position: sticky;
    top: 0;
    z-index: 100;
}

#main-footer {
    background-color: var(--secondary-color);
    color: var(--bg-white);
    text-align: center;
    padding: var(--space-md);
    margin-top: var(--space-xl);
}

/* Class Selectors - Utility and Layout Structure */
.container {
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--space-sm);
    padding-right: var(--space-sm);
}

.navbar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
}

.nav-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    list-style: none;
    text-align: center;
}

.nav-links a {
    color: var(--bg-white);
    font-weight: 500;
}

/* Flexbox Multi-Column Section (Mobile-First / Default Stacked) */
.grid-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-lg);
}

.card {
    background-color: var(--bg-white);
    padding: var(--space-md);
    border-radius: var(--space-xs);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

/* ==========================================================================
   3. RESPONSIVENESS (Mobile-First Media Queries)
   ========================================================================== */

/* --- Tablet Breakpoint (768px and up) --- */
@media screen and (min-width: 768px) {
    .navbar {
        flex-direction: row;
        justify-content: space-between;
    }

    .nav-links {
        flex-direction: row;
        gap: var(--space-md);
    }

    /* Transform stacked sections into a multi-column flex layout */
    .grid-layout {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .card {
        flex: 1 1 calc(50% - var(--space-sm)); /* 2 columns */
    }
}

/* --- Desktop Breakpoint (1200px and up) --- */
@media screen and (min-width: 1200px) {
    .container {
        padding-left: 0;
        padding-right: 0;
    }

    /* Transition layout to 3 columns on wider screens */
    .card {
        flex: 1 1 calc(33.333% - var(--space-md)); /* 3 columns */
    }

    body {
        font-size: 18px; /* Slightly larger typography for large viewports */
    }
}

